{
  "name": "lostboard-daw",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LostBoard / T.R.I.A.D. DAW — a browser-based digital audio workstation with a tactical command-console HUD",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
